    {
      "id": "now-playing",
      "name": "Now playing",
      "category": "Media",
      "description": "Album art, the song and the artist, and how far through. Press to play or pause.",
      "w": 2,
      "h": 2,
      "widget": {
        "flows": [
          {
            "trigger": {
