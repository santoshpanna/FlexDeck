    {
      "id": "mic",
      "name": "Microphone mute",
      "category": "Controls",
      "description": "Mutes the microphone; red while muted.",
      "w": 1,
      "h": 1,
      "widget": {
        "props": {
          "label": "Mic",
          "icon": "mic"
        },
        "flows": [
          {
            "trigger": {
              "gesture": "GESTURE_SHORT_PRESS"
            },
            "blocks": [
              {
                "block": "doAction",
                "plugin": "system",
                "action": "toggle_input_mute",
                "args": {}
              }
            ]
          }
        ],
        "states": {
          "looks": [
            {
              "id": "live"
            },
            {
              "id": "muted",
              "label": "Muted",
              "icon": "mic-off",
              "bgColor": "#7f1d1d"
            }
          ],
          "variable": {
            "variable": "system.audio.input.muted",
            "cases": [
              {
                "value": "true",
                "state": "muted"
              }
            ],
            "otherwise": "live"
          }
        }
      }
    },
