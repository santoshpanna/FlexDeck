{
  "about": "Generated by `pnpm gen:presets` from apps/portal. Do not edit.",
  "presets": [
    {
      "id": "cpu-gauge",
      "name": "CPU gauge",
      "category": "System",
      "description": "How busy the processor is, as a ring that turns red past 85%.",
      "w": 1,
      "h": 1,
      "widget": {
        "face": {
          "layout": "FACE_LAYOUT_DIAL",
          "elements": [
            {
              "slot": "SLOT_VISUAL",
              "kind": "ELEMENT_KIND_GAUGE",
              "template": "{{system.cpu.usage}}",
              "rules": [
                {
                  "when": "system.cpu.usage > 85",
                  "color": "#ef4444"
                }
              ]
            },
            {
              "slot": "SLOT_VALUE",
              "template": "{{ system.cpu.usage | round }}%"
            },
            {
              "slot": "SLOT_CAPTION",
              "template": "CPU"
            }
          ]
        }
      }
    },
    {
      "id": "cpu-graph",
      "name": "CPU history",
      "category": "System",
      "description": "The last minute of processor load behind the number.",
      "w": 2,
      "h": 1,
      "widget": {
        "face": {
          "layout": "FACE_LAYOUT_VALUE",
          "background": {
            "graph": "system.cpu.usage"
          },
          "rules": [
            {
              "when": "system.cpu.usage > 90",
              "color": "#7f1d1d"
            }
          ],
          "elements": [
            {
              "slot": "SLOT_TOP",
              "template": "CPU"
            },
            {
              "slot": "SLOT_VALUE",
              "template": "{{ system.cpu.usage | round }}%",
              "text": {
                "font": "FONT_MONO"
              }
            }
          ]
        }
      }
    },
    {
      "id": "memory",
      "name": "Memory",
      "category": "System",
      "description": "Memory in use, as a bar, with how many gigabytes.",
      "w": 1,
      "h": 1,
      "widget": {
        "face": {
          "layout": "FACE_LAYOUT_VALUE",
          "elements": [
            {
              "slot": "SLOT_TOP",
              "template": "RAM"
            },
            {
              "slot": "SLOT_VALUE",
              "template": "{{ sensors.memory.used | round }}%"
            },
            {
              "slot": "SLOT_CAPTION",
              "template": "{{ sensors.memory.used_gb | round(1) }} / {{ sensors.memory.total_gb | round }} GB"
            },
            {
              "slot": "SLOT_VISUAL",
              "kind": "ELEMENT_KIND_BAR",
              "template": "{{sensors.memory.used}}",
              "rules": [
                {
                  "when": "sensors.memory.used > 90",
                  "color": "#ef4444"
                }
              ]
            }
          ]
        }
      }
    },
