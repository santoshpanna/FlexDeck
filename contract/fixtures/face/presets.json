    {
      "id": "pomodoro",
      "name": "Pomodoro",
      "category": "Time",
      "description": "25 minutes of focus: tap to start or pause, hold to reset. Pulses when the time is up.",
      "w": 1,
      "h": 1,
      "widget": {
        "flows": [
          {
            "trigger": {
              "gesture": "GESTURE_SHORT_PRESS"
            },
            "blocks": [
              {
                "block": "doAction",
                "plugin": "timer",
                "action": "toggle",
                "args": {
                  "name": {
                    "text": "focus"
                  },
                  "minutes": {
                    "text": "25"
                  }
                }
              }
            ]
          },
          {
            "trigger": {
              "gesture": "GESTURE_LONG_PRESS"
            },
            "blocks": [
              {
                "block": "doAction",
                "plugin": "timer",
                "action": "reset",
                "args": {
                  "name": {
                    "text": "focus"
                  }
                }
              }
            ]
          }
        ],
        "face": {
          "layout": "FACE_LAYOUT_VALUE",
          "rules": [
            {
              "when": "timer.focus.done",
              "color": "#7f1d1d",
              "pulse": true
            },
            {
              "when": "timer.focus.running",
              "color": "#14532d"
            }
          ],
          "elements": [
            {
              "slot": "SLOT_TOP",
              "template": "Focus"
            },
            {
              "slot": "SLOT_VALUE",
              "kind": "ELEMENT_KIND_TIMER",
              "variable": "focus"
            },
            {
              "slot": "SLOT_CAPTION",
              "template": "{{ if(timer.focus.running, \"tap to pause\", if(timer.focus.done, \"time for a break\", \"tap to start\")) }}"
            }
          ]
        }
      }
    },
