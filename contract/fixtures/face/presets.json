              "kind": "ELEMENT_KIND_BAR",
              "template": "{{media.current.progress}}",
              "color": "#ffffff"
            },
            {
              "slot": "SLOT_BADGE",
              "template": "{{ if(media.current.playing, \"\", \"❚❚\") }}"
