    {
      "id": "weather",
      "name": "Weather",
      "category": "Web",
      "description": "Temperature and sky now, today's temperatures behind. Set its place in its source.",
      "w": 2,
      "h": 1,
      "needs": {
        "starter": "Weather",
        "id": "weather"
      },
      "widget": {
        "face": {
          "layout": "FACE_LAYOUT_SPLIT",
          "background": {
            "graph": "src.weather.today",
            "graphColor": "#38bdf8"
          },
          "elements": [
            {
              "slot": "SLOT_VISUAL",
              "kind": "ELEMENT_KIND_ICON",
              "template": "{{src.weather.icon}}"
            },
            {
              "slot": "SLOT_TITLE",
              "template": "{{ src.weather.temp | temp }}",
              "text": {
                "size": "TEXT_SIZE_XL",
                "bold": true
              }
            },
            {
              "slot": "SLOT_CAPTION",
              "template": "{{src.weather.sky}} · {{ src.weather.wind | round }} km/h"
            }
          ]
        }
      }
    },
    {
      "id": "crypto",
      "name": "Crypto ticker",
      "category": "Web",
      "description": "A coin's price, green or red with its change over a day. Set the coin in its source.",
      "w": 2,
      "h": 1,
      "needs": {
        "starter": "Crypto price",
        "id": "crypto"
      },
      "widget": {
        "face": {
          "layout": "FACE_LAYOUT_VALUE",
          "rules": [
            {
              "when": "src.crypto.change < -5",
              "color": "#7f1d1d",
              "pulse": true
            }
          ],
          "elements": [
            {
              "slot": "SLOT_TOP",
              "template": "Bitcoin"
            },
            {
              "slot": "SLOT_VALUE",
              "template": "{{ src.crypto.price | currency }}",
              "text": {
                "font": "FONT_MONO"
              }
            },
            {
              "slot": "SLOT_CAPTION",
              "template": "{{ src.crypto.change | round(2) | sign }}% today",
              "rules": [
                {
                  "when": "src.crypto.change < 0",
                  "color": "#ef4444"
                },
                {
                  "when": "src.crypto.change >= 0",
                  "color": "#4ade80"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "calendar",
      "name": "Next meeting",
      "category": "Web",
      "description": "Your calendar's next event and how soon it starts. Paste your calendar's iCal address into its source.",
      "w": 2,
      "h": 1,
      "needs": {
        "starter": "Calendar",
        "id": "calendar"
      },
      "widget": {
        "face": {
          "layout": "FACE_LAYOUT_VALUE",
          "rules": [
            {
              "when": "src.calendar.soon <= 300 and src.calendar.soon > 0",
              "color": "#7f1d1d",
              "pulse": true
            }
          ],
          "elements": [
            {
              "slot": "SLOT_TOP",
              "template": "{{ src.calendar.at | time(\"%a %H:%M\") }}"
            },
            {
              "slot": "SLOT_VALUE",
              "template": "{{ src.calendar.next | default(\"Nothing coming\") | truncate(28) }}",
              "text": {
                "size": "TEXT_SIZE_L",
                "bold": true,
                "maxLines": 2
              }
            },
            {
              "slot": "SLOT_CAPTION",
              "template": "{{ if(src.calendar.soon > 0, \"in \" + (src.calendar.soon | duration), \"now\") }}"
            }
          ]
        }
      }
    }
  ]
}
