{
  "manifest": {
    "abi": 2,
    "id": "sample",
    "name": "Sample",
    "version": "1.2.3",
    "description": "The cross-language contract fixture",
    "author": "flexdeck",
    "actions": [
      {
        "action": "go",
        "description": "Go somewhere",
        "arguments": [
          {
            "name": "where",
            "description": "",
            "example": "left",
            "kind": "choice",
            "choices": [
              "left",
              "right"
            ],
            "optional": false
          },
          {
            "name": "note",
            "description": "",
            "example": "",
            "kind": "text",
            "choices": [],
            "optional": true
          }
        ]
      }
    ],
    "settings": [
      {
        "key": "host",
        "description": "Where to connect",
        "kind": "text",
        "choices": [],
        "defaultValue": "localhost",
        "secret": false
      },
      {
        "key": "password",
        "description": "",
        "kind": "text",
        "choices": [],
        "defaultValue": null,
        "secret": true
      },
      {
        "key": "mode",
        "description": "",
        "kind": "choice",
        "choices": [
          "a",
          "b"
        ],
        "defaultValue": "a",
        "secret": false
      }
    ],
    "events": [
      {
        "name": "changed",
        "description": "Something changed",
        "fields": [
          "what"
        ]
      }
    ],
    "permissions": [
      "network",
      "notifications"
    ]
  },
  "variables": [
    {
      "name": "sample.connected",
      "description": "Connected",
      "kind": "bool",
      "unit": null,
      "choices": [],
      "readOnly": true
    },
    {
      "name": "sample.level",
      "description": "",
      "kind": "number",
      "unit": "%",
      "choices": [],
      "readOnly": false
    }
  ]
}
